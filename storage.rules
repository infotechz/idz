rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && (request.auth.token.admin == true || request.auth.token.email == 'olliveirazvz@gmail.com'); }

    match /profilePictures/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if owner(uid) && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if owner(uid) || admin();
    }
  }
}
