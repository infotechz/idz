rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if admin() || (owner(uid) && request.resource.data.uid == uid && request.resource.data.get('paid', false) == false && request.resource.data.get('role', 'student') == 'student');
      allow update: if admin() || (owner(uid)
        && request.resource.data.get('paid', false) == resource.data.get('paid', false)
        && request.resource.data.get('paymentStatus', 'none') == resource.data.get('paymentStatus', 'none')
        && request.resource.data.get('role', 'student') == resource.data.get('role', 'student')
        && request.resource.data.get('courseAccess', false) == resource.data.get('courseAccess', false));
      allow delete: if admin();

      match /notifications/{notificationId} {
        allow read, update: if owner(uid) || admin();
        allow create: if admin();
        allow delete: if owner(uid) || admin();
      }
    }

    match /modules/{moduleId} {
      allow read: if true;
      allow write: if admin();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if admin();
    }

    match /courseContent/{contentId} {
      allow read: if true;
      allow write: if admin();
    }

    match /progress/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if admin();
    }

    match /notifications/{notificationId} {
      allow read, update: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if admin() || (signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.audience == 'student');
      allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /certificate_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendente';
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.time < timestamp.millis(resource.data.physicalAddressEditUntil)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['address', 'updatedAt']));
      allow delete: if admin();
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'aberto';
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin();
      allow delete: if admin();
    }

    match /refundRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'solicitado';
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin();
      allow delete: if admin();
    }

    match /coupons/{couponId} {
      allow read: if admin();
      allow write: if admin();
    }

    match /payments/{paymentId} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /idempotency/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
