rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read, create, update: if owner(uid) || admin();
      allow delete: if admin();

      match /notifications/{notificationId} {
        allow read, update: if owner(uid) || admin();
        allow create: if admin();
        allow delete: if owner(uid) || admin();
      }
    }

    match /modules/{moduleId} {
      allow read: if true;
      allow write: if admin();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if admin();
    }

    match /courseContent/{contentId} {
      allow read: if true;
      allow write: if admin();
    }

    match /progress/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if admin();
    }

    match /notifications/{notificationId} {
      allow read, update: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if admin() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /certificate_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin() || (
        signedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if admin();
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin() || (
        signedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid
      );
      allow delete: if admin();
    }

    match /refundRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin() || (
        signedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if admin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
