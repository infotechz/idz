rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read, create, update: if owner(uid) || admin();
      allow delete: if admin();
    }

    match /modules/{moduleId} {
      allow read: if true;
      allow write: if admin();
    }

    match /certificate_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin() || (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.status == resource.data.status);
      allow delete: if admin();
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if admin();
    }

    match /notifications/{notificationId} {
      allow read, update: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if admin() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
